<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuackBuddy.Views.DuckWindow"
        Title="QuackBuddy"
        Width="320"
        Height="320"
        MinWidth="128"
        MinHeight="128"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Icon="/Assets/tray_icon.ico">

  <Image x:Name="DuckImage"
         Stretch="Uniform"
         Cursor="Hand"
         PointerPressed="OnDuckPointerPressed"
         PointerMoved="OnDuckPointerMoved"
         PointerReleased="OnDuckPointerReleased" />
</Window>
