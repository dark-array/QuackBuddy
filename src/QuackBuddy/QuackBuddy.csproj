<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>QuackBuddy</RootNamespace>
    <AssemblyName>QuackBuddy</AssemblyName>
    <Product>QuackBuddy</Product>
    <Version>0.1.0</Version>
    <Authors>QuackBuddy Contributors</Authors>
    <Description>Lightweight always-on-top rubber duck debugging companion.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\duck_eyes_open.png" Link="Assets\duck_eyes_open.png" />
    <AvaloniaResource Include="..\..\assets\duck_eyes_closed.png" Link="Assets\duck_eyes_closed.png" />
    <AvaloniaResource Include="..\..\assets\tray_icon.ico" Link="Assets\tray_icon.ico" />
    <EmbeddedResource Include="..\..\assets\quack.wav" Link="Assets\quack.wav" LogicalName="QuackBuddy.Assets.quack.wav" />
  </ItemGroup>
</Project>
